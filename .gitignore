# Data (raw and derived) -- too large for git, never commit
data/raw/
data/processed/
data/interim/
*.parquet
*.csv
*.h5
*.hdf5

# Model checkpoints and experiment artifacts
checkpoints/
models/*.pt
models/*.pth
models/*.pkl
models/*.joblib
outputs/
mlruns/

# Jupyter
.ipynb_checkpoints/
*/.ipynb_checkpoints/*
roofline_explainer.ipynb


# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
build/
dist/
.Python

# Virtual environments
.venv/
venv/
env/
ENV/

# Environment / secrets
.env
*.env.local

# OS/editor cruft
.DS_Store
Thumbs.db
.vscode/
.idea/

# Logs
*.log
logs/

# Personal working notes -- not versioned project artifacts
EXPERIMENT_TRACKER.md
WRITING_TRACKER.md

# Thesis draft in progress -- not the final version, not for the public repo
writing/build_thesis_doc.py
writing/thesis_draft_notes.docx

# Curated results ledger -- meant to be committed and reviewed, unlike the
# raw/derived-data CSVs the blanket *.csv rule above is for
!results/*.csv

# Optuna's persistent per-pair study storage (SQLite) -- large, regenerable, not reviewed
results/optuna_studies/*.db

# notebook06 development/debug artifacts -- scratch probes from building the DL sweep
# (GPU concurrency timing, single/multi-epoch trial runs, the pre-sweep step-2 gate check,
# per-trial per-epoch training logs), never read back by any notebook and superseded by the
# real per-pair results in results/notebook06_sweep_result_*.csv
results/notebook06_concurrency_gpu*.txt
results/notebook06_*multiepoch_trial*.csv
results/notebook06_phase1_epoch_timing*.csv
results/notebook06_step2*gate*.csv
results/notebook06_sweep_epochlog_*.csv

# Scratch holding area for pre-commit cleanup -- reviewed, never committed
_to_delete/
